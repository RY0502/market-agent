HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
LOOKBACK_DAYS=30
GAINERS_INCREASE_RS=100
LOSERS_DECREASE_RS=100
GAINERS_MIN_PRICE=200
GAINERS_MAX_PRICE=2000
LOSERS_MIN_PRICE=200
LOSERS_MAX_PRICE=1500
RESEARCH_TIMEOUT_MS=360000
RESEARCH_CONCURRENCY=5
RESEARCH_MAX_MODEL_CALLS=20
RESEARCH_MAX_TOOL_CALLS=40
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_REPORT_URL=https://stock-reports.YOUR_SUBDOMAIN.workers.dev
# Same random secret (at least 32 characters) as the Worker's REPORT_UPLOAD_TOKEN.
CLOUDFLARE_REPORT_UPLOAD_TOKEN=
NEON_DATABASE_URL=
TAVILY_API_KEY=
SCRAPE_AGENT_URL=https://scrape-agent.onrender.com
# Required by validateConfig() in the pinned upstream framework:
NVIDIA_DEEP_AGENT_API_KEY_1=
ANYAPI_AGENT_KEY_1=
REQUESTY_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=

# --- Agent lifecycle & Freestyle VM ---
# Every canonical agent invocation first clears Neon framework/checkpoint state.
# After success, an early return, or an error, it sends exactly one GET to:
#   ${PAUSE_BASE_URL}/pause/vm?machine=${MACHINE_NO}
PAUSE_BASE_URL=
# MACHINE_NO is accepted as an uppercase compatibility alias.
MACHINE_NO=
