    "@supabase/supabase-js": "^2.57.0",
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.4.0",
    "fflate": "^0.8.2",
    "freetier-deepagent-framework": "github:RY0502/freetier-deepagent-framework#ca8b0dd1b60488ecf9d1a7540c05dba04ae8f680",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
