    "reports:setup": "tsx src/setup-reports.ts",
    "reports:purge": "tsx src/purge-reports.ts"
  },
  "dependencies": {
    "@freetier/orchestrator": "github:RY0502/freetier-orchestrator#c57d603741a9369c87d9672d2d94a9a9e679ebd7",
